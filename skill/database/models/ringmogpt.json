  "version": "1.0",
  "release_date": "2024-12-04T00:00:00Z",
  "updated": "2025-02-25T00:00:00Z",
  "description": "RingMoGPT is a unified multimodal remote sensing foundation model integrating vision, language, and localization tasks. It features a location- and instruction-aware Q-Former and a change detection module, trained on large-scale high-quality image-text and instruction-tuning datasets, supporting tasks such as scene classification, object detection, VQA, image captioning, grounded captioning, and change captioning.",
  "sci:doi": "10.1109/TGRS.2024.3510833",
  "license": null,
  "assets": null,
  "mlm:architecture": "ViT-g/14 (from EVA-CLIP) as visual encoder, Vicuna-13B as LLM",
  "mlm:total_parameters": null,
  "pretext_training_type": "Adapter-based domain adaptation with frozen visual encoder and LLM, training only adapter parameters",
  "masking_strategy": "Masked image modeling and instruction-based masking",
  "pretraining": "Pretrained on 522,769 high-quality RS image-text pairs with rule-based and VLM-generated captions, followed by instruction-tuning on 1.6M QA pairs across six tasks.",
  "domain_knowledge": [
    "Remote sensing domain adaptation",
    "Location-aware querying",
    "Multitemporal change analysis"
  ],
  "backbone_modifications": [
    "Integration of Q-Former with location and semantic queries",
    "Graph Attention Networks in cross-attention module",
    "Change detection module (2-layer MLP)"
  ],
  "supported_sensors": [
    "Optical remote sensing imagery"
  ],
  "modality_integration_type": "Homogeneous Multimodal",
