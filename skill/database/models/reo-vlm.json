  "version": "1.0",
  "release_date": "2024-12-21T00:00:00Z",
  "updated": "2024-12-21T00:00:00Z",
  "description": "REO-VLM is a unified vision-language model for Earth Observation that integrates regression and generative capabilities, enabling both scientific regression (e.g., above-ground biomass estimation) and image content interpretation from multimodal EO data. It is trained and evaluated on the REO-Instruct benchmark, which contains 1.6 million EO-language pairs with RGB, multispectral, and SAR imagery.",
  "sci:doi": "10.48550/arXiv.2412.16583",
  "license": null,
  "assets": null,
  "mlm:architecture": "LLaVA-1.5",
  "mlm:total_parameters": null,
  "pretext_training_type": "Two-stage: first stage for generation (cross-entropy loss), second stage for regression (MSE loss)",
  "masking_strategy": null,
  "pretraining": "Two-stage training: (1) fine-tune LLM and generation head with cross-entropy loss; (2) fine-tune regression head and reverse projection module with MSE loss. Visual encoder and multimodal projector are frozen.",
  "domain_knowledge": [
    "Land cover domain knowledge",
    "Ecological patch counting",
    "Human activity monitoring",
    "Above-ground biomass regression"
  ],
  "backbone_modifications": [
    "Spectral recombination and pseudo-RGB strategies for MS and SAR alignment",
    "Visual token selection module",
    "Reverse projection module",
    "Four-layer MLP-mixer regression head"
  ],
  "supported_sensors": [
    "Sentinel-2",
    "ALOS-2 PALSAR-2"
  ],
