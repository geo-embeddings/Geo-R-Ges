{
  "id": "teochat",
  "mlm:name": "TEOChat",
  "version": "1.0",
  "release_date": null,
  "updated": null,
  "description": "TEOChat is the first vision-language model (VLM) for temporal earth observation (EO) data, capable of engaging in conversations about temporal sequences of EO images. It is trained on TEOChatlas, a large instruction-following dataset with both single image and temporal EO tasks, and demonstrates strong spatial and temporal reasoning, outperforming prior VLMs and rivaling specialist models.",
  "sci:doi": "10.48550/arXiv.2410.06234",
  "license": null,
  "assets": {
    "mlm:source_code": {
      "href": "https://github.com/ermongroup/TEOChat",
      "title": "Source code",
      "type": "text/html",
      "roles": [
        "mlm:source_code",
        "code"
      ]
    },
    "weights": {
      "href": "https://github.com/ermongroup/TEOChat",
      "title": "Model weights",
      "roles": [
        "mlm:model",
        "mlm:weights"
      ]
    }
  },
  "mlm:architecture": "CLIP ViT-L/14 (Radford et al., 2021)",
  "mlm:total_parameters": null,
  "pretext_training_type": "Instruction tuning (visual instruction tuning) with next-token cross-entropy loss",
  "masking_strategy": "None (no explicit masking, uses instruction tuning)",
  "pretraining": "Instruction-tuned on TEOChatlas, which includes both single image and temporal EO tasks from multiple datasets and sensors",
  "domain_knowledge": [
    "Temporal reasoning",
    "Spatial reasoning",
    "Change detection",
    "Scene classification",
    "Visual question answering",
    "Region-based reasoning"
  ],
  "backbone_modifications": [
    "Temporally-shared image encoder (Siamese across time)",
    "2-layer MLP vision-language connector",
    "LLM decoder (Llama 2)"
  ],
  "supported_sensors": [
    "WorldView-2",
    "WorldView-3",
    "Sentinel-2",
    "GaoFen",
    "Jilin-1",
    "DJI Mavic Pro",
    "SuperView",
    "BeiJing-2"
  ],
  "modality_integration_type": "Homogeneous Multimodal",
  "modalities": [
    "Optical RGB",
    "Multispectral (Sentinel-2)"
  ],
  "spectral_alignment": "none",
  "temporal_alignment": "partial",
  "spatial_resolution": "224x224 pixels (input images resized and cropped)",
  "temporal_resolution": "variable (bitemporal, pentatemporal, multitemporal up to 8 images)",
  "mlm:input": [
    {
      "name": "WorldView-2, WorldView-3, Sentinel-2, GaoFen, Jilin-1, DJI Mavic Pro, SuperView, BeiJing-2",
      "bands": [
        "RGB",
        "Sentinel-2 bands (multispectral)"
      ],
      "input": {
        "shape": [
          -1,
          -1,
          -1,
          224,
          224
        ],
        "dim_order": [
          "batch",
          "time",
          "bands",
          "height",
          "width"
        ]
      }
    }
  ],
  "mlm:pretrained_source": "TEOChatlas (GeoChat Instruct, fMoW, xBD, S2Looking, QFabric)",
  "regions_coverage": [
    "Global (fMoW, xBD, S2Looking, QFabric, GeoChat Instruct cover worldwide locations)"
  ],
  "start_datetime": null,
  "end_datetime": null,
  "num_images": 1244393,
  "sampling": "Random sampling of up to 8 images for long sequences; random sampling of shorter sequences from QFabric",
  "processing:level": null,
  "processing:lineage": "Resize shorter side to 224; Center crop to 224x224",
  "cloud_cover": null,
  "missing_data": null,
