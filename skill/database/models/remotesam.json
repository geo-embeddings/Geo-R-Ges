        "mlm:source_code",
        "code"
      ]
    }
  },
  "mlm:architecture": "Swin-Base (visual encoder) + BERT (text encoder)",
  "mlm:total_parameters": 180000000,
  "pretext_training_type": "Referring Expression Segmentation (RES) with multi-task conversion",
  "masking_strategy": "Masking via pseudo-labels from expert models and null masks for absent categories",
  "pretraining": "Trained on RemoteSAM-270K, a large-scale, automatically curated referring expression segmentation dataset with 270K image-text-mask triplets, 297 categories, and 16 attributes. Utilizes VLMs for expression generation and multi-teacher pseudo-labeling.",
  "domain_knowledge": [
    "Hierarchical remote sensing semantic vocabulary (RSVocab-1K)",
    "Multi-source dataset integration",
    "Semantic attribute enrichment"
  ],
  "backbone_modifications": [
    "Unified architecture without task-specific heads",
    "Pixel-level output as fundamental computation unit"
  ],
