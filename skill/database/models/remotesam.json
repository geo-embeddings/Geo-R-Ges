  "version": "v1",
  "release_date": "2025-06-02T00:00:00Z",
  "updated": "2025-06-02T00:00:00Z",
  "description": "RemoteSAM is a unified visual foundation model for Earth observation, centered on referring expression segmentation. It achieves state-of-the-art performance across pixel-level, region-level, and image-level remote sensing tasks with high parameter efficiency, leveraging a large-scale, semantically diverse dataset (RemoteSAM-270K).",
  "sci:doi": "10.48550/arXiv.2505.18022",
  "license": null,
