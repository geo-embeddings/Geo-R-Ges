    "global",
    "various geographical locations"
  ],
  "start_datetime": null,
  "end_datetime": null,
  "num_images": 11110000,
  "sampling": null,
  "processing:level": null,
  "processing:lineage": "luminance and coverage-based filtering; label-based filtering",
  "cloud_cover": "luminance and coverage-based filtering to remove cloudy images",
  "missing_data": null,
