        "SAR",
        "Mag1c",
        "Multispectral"
      ]
    }
  ],
  "mlm:pretrained_source": "EarthDial-Instruct (SkyScript, SatlasPretrain, NAIP, Sentinel-2, Landsat, Sentinel-1)",
