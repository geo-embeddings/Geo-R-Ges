    "SAR",
    "RGB",
    "Infrared",
    "NIR",
    "Hyperspectral",
    "Aerial"
  ],
  "spectral_alignment": "full",
  "temporal_alignment": "full",
  "spatial_resolution": "variable (supports high and low resolution, e.g., 0.5m, 10m, 30m)",
  "temporal_resolution": "variable",
  "mlm:input": [
    {
      "name": "Sentinel-2, Sentinel-1, Landsat 8, NAIP, Aerial imagery",
