{
  "id": "earthdial",
  "mlm:name": "EarthDial",
  "version": "v1",
  "release_date": null,
  "updated": null,
  "description": "EarthDial is a domain-specialized vision-language model (VLM) for Earth Observation (EO) data, capable of processing multi-spectral, multi-temporal, and multi-resolution remote sensing imagery for a wide range of tasks including classification, detection, captioning, question answering, visual reasoning, and visual grounding. It is trained on the largest remote sensing instruction dataset (11.11M pairs) covering RGB, SAR, multispectral, NIR, and infrared modalities.",
  "sci:doi": "10.48550/arXiv.2412.15190",
  "license": null,
  "assets": {
    "mlm:source_code": {
      "href": "https://github.com/hiyamdebary/EarthDial",
      "title": "Source code",
      "type": "text/html",
      "roles": [
        "mlm:source_code",
        "code"
      ]
    }
  },
  "mlm:architecture": "InternViT-300M (vision encoder), Phi-3-mini (LLM)",
  "mlm:total_parameters": 4000000000,
  "pretext_training_type": "Instruction tuning with multi-stage pretraining (conversational pretraining, RGB/temporal finetuning, multispectral/SAR finetuning)",
  "masking_strategy": null,
  "pretraining": "Three-stage pretraining: (1) conversational pretraining on large-scale remote sensing image-text pairs, (2) RGB and temporal finetuning for downstream tasks, (3) multispectral and SAR finetuning with data fusion module.",
  "domain_knowledge": [
    "Adaptive High Resolution module",
    "Data Fusion module for multi-spectral/temporal/SAR"
  ],
  "backbone_modifications": [
    "Adaptive High Resolution block",
    "Data Fusion module for multi-spectral/temporal"
  ],
  "supported_sensors": [
    "Sentinel-2",
    "Sentinel-1",
    "Landsat 8",
    "NAIP",
    "Aerial imagery"
  ],
  "modality_integration_type": "Heterogeneous Multimodal",
