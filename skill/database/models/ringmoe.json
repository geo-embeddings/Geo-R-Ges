{
  "id": "ringmoe",
  "mlm:name": "RingMoE",
  "version": "1.0",
  "release_date": null,
  "updated": null,
  "description": "RingMoE is a 14.7-billion-parameter multi-modal remote sensing foundation model, pre-trained on 400 million images from nine satellites across four modalities (Optical, Multi-spectral, SAR-L1, SAR-L2). It uses a hierarchical Mixture-of-Experts (MoE) architecture with modal-specialized, collaborative, and shared experts, incorporates physics-informed self-supervised learning, and supports dynamic expert pruning for efficient deployment. RingMoE achieves SOTA results on 23 out of 25 public benchmarks across six key remote sensing tasks.",
  "sci:doi": "10.48550/arXiv.2504.03166",
  "license": null,
  "assets": null,
  "mlm:architecture": "Swin Transformer v2",
  "mlm:total_parameters": 14700000000,
  "pretext_training_type": "Masked image modeling (MIM) with physics-informed self-supervised learning",
  "masking_strategy": "Random masking of image patches; physics-informed masking for SAR-L1",
  "pretraining": "Self-supervised masked image reconstruction with modal-specific decoders and hierarchical Mixture-of-Experts encoder",
  "domain_knowledge": [
    "Physics-informed loss for SAR-L1 (power conservation)",
    "Sensor-specific radiometric characteristics"
  ],
  "backbone_modifications": [
    "Replace FFN with hierarchical Mixture-of-Experts (RMoE) layer",
    "Modal-specialized, collaborative, and shared experts"
  ],
