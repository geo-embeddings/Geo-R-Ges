{
  "id": "hypersigma",
  "mlm:name": "HyperSIGMA",
  "version": null,
  "release_date": null,
  "updated": null,
  "description": "HyperSIGMA is a vision transformer-based foundation model for hyperspectral image (HSI) interpretation, scalable to over 1 billion parameters. It introduces a sparse sampling attention (SSA) mechanism and a spectral enhancement module, and is pre-trained on the large-scale HyperGlobal-450K dataset (about 450,000 HSIs). HyperSIGMA provides a unified solution for both high-level and low-level HSI tasks, demonstrating superior performance, scalability, robustness, cross-modal transferability, and computational efficiency.",
  "sci:doi": "10.48550/arXiv.2406.11519",
  "assets": null,
  "mlm:architecture": "Vision Transformer (ViT)",
  "mlm:total_parameters": 1000000000,
  "pretext_training_type": "Masked Image Modeling (MAE)",
  "masking_strategy": "Random masking of spatial patches (spatial MAE) and random masking of spectral channels (spectral MAE), both with mask ratio 0.75",
  "pretraining": "Unsupervised pre-training using MAE on HyperGlobal-450K, with separate spatial and spectral subnetworks, followed by fusion via a spectral enhancement module.",
  "domain_knowledge": [
    "Spatial-spectral feature fusion",
    "Sparse sampling attention",
    "Spectral enhancement module"
  ],
  "backbone_modifications": [
    "SSA replaces full self-attention in most transformer blocks",
    "Spectral enhancement module for spatial-spectral fusion",
    "Separate spatial and spectral subnetworks"
  ],
  "supported_sensors": [
    "EO-1",
    "GF-5"
  ],
  "modality_integration_type": "Unimodal",
  "modalities": [
    "Hyperspectral"
  ],
  "spectral_alignment": "full",
  "temporal_alignment": "none",
  "spatial_resolution": "variable (depends on EO-1 and GF-5 sensors)",
  "temporal_resolution": "variable",
  "mlm:input": null,
  "mlm:pretrained_source": "HyperGlobal-450K",
  "regions_coverage": [
    "Global (EO-1 worldwide, GF-5 China)"
  ],
  "start_datetime": null,
  "end_datetime": null,
  "num_images": 447072,
  "sampling": "Random channel selection, consistent number of channels per HSI; Time range: 2011-2017 (EO-1), additional GF-5 images",
  "processing:level": null,
  "processing:lineage": "Randomly select continuous channels for dimensionality reduction",
  "cloud_cover": "Images selected based on cloud content",
