  "mlm:architecture": "Symmetric Transformer-based encoder-decoder",
  "mlm:total_parameters": null,
  "pretext_training_type": "Masked token modeling (cross-modal patch classification)",
  "masking_strategy": "Random masking of input and target tokens sampled from a Dirichlet distribution",
  "pretraining": "Dual-scale pretraining on pixel-level and token-level data across multiple EO modalities, using cross-entropy loss to reconstruct masked target tokens from random subsets of input tokens and pixel-level data.",
  "domain_knowledge": [
    "Spatiotemporal alignment",
    "Land use/land cover class balancing",
    "Cloud/ice masking",
    "Spectral index computation (NDVI)",
    "Synthetic caption generation"
  ],
  "backbone_modifications": [
    "Dual-scale early fusion (pixel-level and token-level)",
    "Modality-specific tokenizers with FSQ and diffusion decoders"
  ],
