  "mlm:name": "SatCLIP",
  "version": "1.0",
  "release_date": null,
  "updated": null,
  "description": "SatCLIP is a global, general-purpose geographic location encoder trained via contrastive learning to match multispectral Sentinel-2 satellite imagery with their geographic coordinates, producing 256-dimensional location embeddings for downstream geospatial tasks.",
