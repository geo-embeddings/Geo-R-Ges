{
  "id": "seamo",
  "mlm:name": "SeaMo",
  "version": null,
  "release_date": "2025-04-22T00:00:00Z",
  "updated": "2025-04-22T00:00:00Z",
  "description": "SeaMo is a season-aware multimodal foundation model for remote sensing that integrates spatial, multimodal, and multi-seasonal information using a masked image modeling framework. It employs unaligned spatial region selection, multi-source inputs, and temporal-multimodal fusion blocks to explicitly model spatial, spectral, and seasonal dimensions, enhancing generalization and robustness across geoscientific tasks.",
  "sci:doi": "10.48550/arXiv.2412.19237",
  "assets": null,
  "mlm:architecture": "ViT-Base",
  "mlm:total_parameters": null,
  "pretext_training_type": "Masked Image Modeling (MIM)",
  "masking_strategy": "Selective masking with consistent masking for simultaneous multi-sensor images and random masking for different times; partial overlap cropping across seasons",
  "pretraining": "Progressive pretraining: first on single-time multimodal data (25% of data, no TM block, 20 epochs), then on multi-seasonal multimodal data with temporal-multimodal (TM) fusion blocks (200 epochs).",
  "domain_knowledge": [
    "Seasonal awareness",
    "Geospatial region selection",
    "Temporal-multimodal fusion"
  ],
  "backbone_modifications": [
    "Unified multimodal feature encoder",
    "Temporal-multimodal fusion block (TM block)",
    "Modality-specific patch embedding modules"
  ],
  "supported_sensors": [
    "Sentinel-2",
    "Sentinel-1"
  ],
  "modality_integration_type": "Heterogeneous Multimodal",
  "modalities": [
    "Multispectral",
    "SAR"
  ],
  "spectral_alignment": "partial",
  "temporal_alignment": "full",
  "spatial_resolution": "10m",
  "temporal_resolution": "4 seasonal snapshots per year",
  "mlm:input": [
    {
      "name": "Sentinel-2",
      "bands": [
        "12 multispectral bands"
      ]
    },
    {
      "name": "Sentinel-1",
      "bands": [
        "2 SAR bands (VV, VH)"
      ]
    }
  ],
  "mlm:pretrained_source": "SSL4EO-S12",
  "regions_coverage": [
    "250,000 locations worldwide"
  ],
  "start_datetime": null,
  "end_datetime": null,
  "num_images": 3000000,
  "sampling": "Progressive: first phase uses only first season (25% of data), second phase uses all seasons; Time range: 4 seasonal snapshots per location within a calendar year",
  "processing:level": "Sentinel-2 Level-2A",
  "processing:lineage": "Normalization as in SSL4EO-S12",
  "cloud_cover": "Images with high cloud cover excluded",
  "missing_data": null,
