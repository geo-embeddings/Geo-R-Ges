{
  "id": "earthgpt",
  "mlm:name": "EarthGPT",
  "version": null,
  "release_date": null,
  "updated": null,
  "description": "EarthGPT is a pioneering multi-modal large language model (MLLM) designed for universal remote sensing (RS) image comprehension. It unifies multi-sensor and diverse RS interpretation tasks, including scene classification, image captioning, region-level captioning, visual question answering (VQA), visual grounding, and object detection, across optical, SAR, and infrared modalities. It introduces a visual-enhanced perception mechanism, cross-modal mutual comprehension, and unified instruction tuning, and is trained on the large-scale MMRS-1M dataset (over 1M image-text pairs from 34 RS datasets).",
  "sci:doi": "10.48550/arXiv.2401.16822",
  "assets": {
    "mlm:source_code": {
      "href": "https://github.com/wivizhang/EarthGPT",
      "title": "Source code",
      "type": "text/html",
      "roles": [
        "mlm:source_code",
        "code"
      ]
    }
  },
  "mlm:architecture": "LLaMA-2 (LLM), DINOv2 ViT-L/14 (ViT encoder), CLIP ConvNeXt-L (CNN encoder)",
  "mlm:total_parameters": null,
  "pretext_training_type": "Instruction tuning, cross-modal mutual comprehension, visual-language alignment",
  "masking_strategy": null,
  "pretraining": "Stage 1: Visual-enhanced perception (ViT and CNN frozen, extract multi-layer and multi-scale features); Stage 2: Cross-modal mutual comprehension (unfrozen self-attention and RMSNorm in LLaMA-2, trained on LAION-400M and COCO Caption for vision-language alignment); Stage 3: Unified instruction tuning for RS (bias tuning of linear layers in LLaMA-2, trained on MMRS-1M for multi-task RS instruction following)",
  "domain_knowledge": [
    "Remote sensing domain-specific instruction tuning",
    "Multi-sensor (optical, SAR, infrared) data integration"
  ],
  "backbone_modifications": [
    "Visual-enhanced perception mechanism (mixing ViT and CNN backbones)",
    "Unfreezing self-attention and RMSNorm layers for cross-modal alignment",
    "Bias and shift tuning in LLaMA-2 linear layers"
  ],
