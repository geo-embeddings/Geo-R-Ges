  "mlm:architecture": "Dual-branch pixel-wise Transformer with attention pooling (students N/S/M/L: 1.1M/7.1M/21.0M/43.8M; teacher: 2.06B with cross-modal fusion Transformer)",
  "mlm:total_parameters": 43831170,
  "pretext_training_type": "Self-supervised Barlow Twins with mix-up regularisation (teacher), then Matryoshka knowledge distillation (students)",
  "masking_strategy": "Random variable-length temporal subsampling (8 or 16 observations per view) and whole-modality dropout",
  "pretraining": "The 2B teacher is pretrained for one epoch on about 14 billion d-pixels (annual Sentinel-1/2 pixel time series) sampled from 3,420,048 globally distributed 64x64 patches, with Barlow Twins plus mix-up and global shuffling, on 512 GPUs. Model size and data were allocated with a downstream-driven scaling law fitted on 395 runs. Four students are then distilled from cached teacher embeddings on 1.2 billion d-pixels with a Matryoshka cosine loss at prefixes 16/32/64/128.",
  "domain_knowledge": [
    "Day-of-year positional encoding",
    "Pixel-wise annual time series (d-pixels)",
    "Sentinel-2 SCL cloud masking",
    "Separate standardisation of Sentinel-1 ascending and descending passes",
    "Downstream-driven scaling law for compute allocation"
  ],
  "backbone_modifications": [
    "Dual-branch per-modality Transformers",
    "Learned attention pooling over variable-length time series",
    "Cross-modal fusion Transformer (teacher)",
    "Matryoshka prefix heads for nested 16/32/64/128-d embeddings (distillation only)",
    "Adaptive bucket sampling of all valid observations at inference"
  ],
