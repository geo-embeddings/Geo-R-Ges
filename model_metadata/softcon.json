{
  "id": "softcon",
  "mlm:name": "SoftCon",
  "version": "1.0",
  "release_date": "2024-10-22T00:00:00Z",
  "updated": "2024-10-24T00:00:00Z",
  "description": "SoftCon is a multilabel-guided soft contrastive learning framework for efficient Earth observation (EO) pretraining, leveraging land-cover-generated multilabel supervision and continual pretraining from vision foundation models. It produces multispectral and SAR foundation models that achieve SOTA results in 10 out of 11 downstream tasks.",
  "sci:doi": "10.1109/TGRS.2024.3466896",
  "assets": {
    "mlm:source_code": {
      "href": "https://github.com/zhu-xlab/softcon",
      "title": "Source code",
      "type": "text/html",
      "roles": [
        "mlm:source_code",
        "code"
      ]
    }
  },
  "mlm:architecture": "ResNet50, ViT-S/14, ViT-B/14",
  "mlm:total_parameters": null,
  "pretext_training_type": "Self-supervised contrastive learning with multilabel-guided soft contrastive loss",
  "masking_strategy": "Siamese masking (randomly mask out 20% of input patches for ViT backbones during continual pretraining)",
  "pretraining": "Pretrained on SSL4EO-S12-ML, a large-scale global multilabel dataset built by matching SSL4EO-S12 Sentinel-1/2 images with Dynamic World land-cover maps. Continual pretraining from vision foundation models (DINO/DINOv2) with simple weight initialization and Siamese masking.",
  "domain_knowledge": [
    "Land-cover-generated multilabel supervision",
    "Cross-domain continual pretraining from vision foundation models"
  ],
  "backbone_modifications": [
    "Separate projectors for contrastive and soft contrastive loss",
    "Siamese masking for ViT"
  ],
  "supported_sensors": [
    "Sentinel-2",
    "Sentinel-1"
  ],
  "modality_integration_type": "Homogeneous Multimodal",
  "modalities": [
    "Multispectral",
    "SAR"
  ],
  "spectral_alignment": "partial",
  "temporal_alignment": "partial",
  "spatial_resolution": "10m",
  "temporal_resolution": "variable",
