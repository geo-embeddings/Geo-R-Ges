  "updated": "2024-12-19T00:00:00Z",
  "description": "VHM is a Versatile and Honest Vision Language Model for remote sensing image analysis, trained on a large-scale image-text dataset (VersaD) with rich-content captions and an honest instruction dataset (HnstD) containing both factual and deceptive questions. It supports a wide range of remote sensing tasks and is designed to provide truthful answers.",
  "sci:doi": "10.48550/arXiv.2403.20213",
  "assets": {
    "mlm:source_code": {
      "href": "https://github.com/opendatalab/VHM",
      "title": "Source code",
      "type": "text/html",
      "roles": [
        "mlm:source_code",
        "code"
      ]
    }
  },
  "mlm:architecture": "CLIP-Large (ViT-L/14) + Vicuna-v1.5-7B",
  "mlm:total_parameters": 7000000000,
  "pretext_training_type": "Vision-language pretraining with image-text alignment and instruction tuning",
  "masking_strategy": null,
  "pretraining": "Two-stage: (1) Pretraining on large-scale RS image-text pairs with rich-content captions (VersaD); (2) Supervised fine-tuning on instruction datasets including factual and deceptive questions (VersaD-Instruct, VariousRS-Instruct, HnstD).",
  "domain_knowledge": [
    "Remote sensing image properties",
    "Object attributes",
    "Scene context",
    "Honest question answering"
  ],
  "backbone_modifications": [
    "Multi-level feature integration (concatenation of 8th, 16th, 24th transformer layers)",
    "Compression and projection layers"
  ],
