  "description": "SpectralEarth is a hyperspectral foundation model pre-trained on a large-scale, globally distributed EnMAP dataset using self-supervised learning (SSL) algorithms (MoCo-V2, DINO, MAE) with spectral adapters integrated into ResNet and ViT backbones. It is designed for generalizable hyperspectral image analysis and evaluated on multiple downstream land cover and crop type mapping tasks.",
  "sci:doi": "10.48550/arXiv.2408.08447",
  "assets": null,
  "mlm:architecture": "ResNet-50, ViT-S, ViT-B, ViT-L, ViT-H, ViT-g",
  "mlm:total_parameters": null,
  "pretext_training_type": "Self-supervised learning (MoCo-V2, DINO, MAE)",
  "masking_strategy": "For MAE: random masking of 90% of tokens (patches)",
  "pretraining": "Pre-trained on SpectralEarth, a large-scale EnMAP hyperspectral dataset, using SSL algorithms (MoCo-V2, DINO, MAE) with spectral adapters for spectral feature extraction.",
  "domain_knowledge": [
    "Spectral adapter for spectral feature extraction",
    "Temporal positives for contrastive learning",
    "Cloud cover filtering",
    "Patch-based spatial sampling"
  ],
  "backbone_modifications": [
    "Replace stem layers with 1D spectral adapter (3x Conv1D+BN+ReLU)",
    "No initial downscaling in ResNet",
    "Patch size 4x4 in ViT",
    "Input channel adaptation for 202 bands"
  ],
  "supported_sensors": [
    "EnMAP",
