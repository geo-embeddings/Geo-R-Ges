{
  "id": "panopticon",
  "mlm:name": "Panopticon",
  "version": "v1",
  "release_date": "2025-03-13T00:00:00Z",
  "updated": "2025-03-13T00:00:00Z",
  "description": "Panopticon is an any-sensor foundation model for Earth Observation, extending DINOv2 with multi-sensor view generation, spectral subsampling, and cross-attention over channels, enabling sensor-agnostic processing of multispectral, hyperspectral, and SAR data.",
  "sci:doi": "10.48550/arXiv.2503.10845",
  "assets": {
    "mlm:source_code": {
      "href": "https://github.com/Panopticon-FM/panopticon",
      "title": "Source code",
      "type": "text/html",
      "roles": [
        "mlm:source_code",
        "code"
      ]
    }
  },
  "mlm:architecture": "ViT-B (Vision Transformer Base)",
  "mlm:total_parameters": null,
  "pretext_training_type": "Self-supervised learning with multi-view distillation (DINOv2 framework) and spectral progressive pre-training",
  "masking_strategy": "Spectral subsampling/cropping and spatial cropping; metainfo-aware masking",
  "pretraining": "Two-stage progressive pre-training: first on fMoW, then on all datasets (fMoW, SatlasPretrain, MMEarth, SpectralEarth), with spectral and spatial augmentations, cross-attention patch embedding, and spectral positional embeddings.",
  "domain_knowledge": [
    "Spectral response function encoding",
    "SAR polarization/orbit encoding",
    "Spectral convolution for sensor simulation"
  ],
  "backbone_modifications": [
    "Cross-attention over channels in patch embedding",
    "Spectral positional embeddings",
    "Wider embedding dimension in channel attention"
  ],
