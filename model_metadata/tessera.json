  },
  "mlm:architecture": "Dual-branch Transformer (4-layer per modality) + GRU pooling + MLP fusion",
  "mlm:total_parameters": 45700000,
  "pretext_training_type": "Self-supervised learning with Barlow Twins objective",
  "masking_strategy": "Sparse random temporal sampling (cloud-free observations)",
  "pretraining": "Self-supervised pretraining on ~800 million d-pixels from global Sentinel-1/2 time series (2017-2024), using Barlow Twins loss, global shuffling, and mix-based regularization. Quantization-aware training for int8 embeddings.",
  "domain_knowledge": [
    "Temporal sampling invariance",
    "Global shuffling",
    "Mix-based regularization",
    "Day-of-Year positional encoding"
  ],
  "backbone_modifications": [
    "Dual-branch modality-specific encoders",
    "Learnable Day-of-Year positional encoding",
    "GRU-based temporal pooling",
    "Quantization-aware training"
