{
  "id": "croma",
  "mlm:name": "CROMA",
  "version": "1.0",
  "release_date": "2023-11-01T00:00:00Z",
  "updated": "2023-11-01T00:00:00Z",
  "description": "CROMA is a remote sensing foundation model that combines contrastive and reconstruction self-supervised objectives to learn rich unimodal and multimodal representations from spatially aligned multispectral optical and SAR data. It introduces 2D-ALiBi and X-ALiBi for spatial bias in attention, enabling extrapolation to larger images and outperforming prior state-of-the-art models on multiple benchmarks.",
  "sci:doi": "10.48550/arXiv.2311.00566",
  "assets": {
    "mlm:source_code": {
      "href": "https://github.com/antofuller/CROMA",
      "title": "Source code",
      "type": "text/html",
      "roles": [
        "mlm:source_code",
        "code"
      ]
    }
  },
  "mlm:architecture": "Vision Transformer (ViT-B and ViT-L)",
  "mlm:total_parameters": null,
  "pretext_training_type": "Joint contrastive and masked autoencoding (reconstruction) self-supervised learning",
  "masking_strategy": "MAE-style random masking; independently mask 75% of radar and optical patches",
  "pretraining": "Joint pretraining of three encoders (optical, radar, and joint radar-optical) end-to-end on SSL4EO Sentinel-1 & 2 data, using contrastive and reconstruction objectives with 2D-ALiBi and X-ALiBi positional encoding.",
  "domain_knowledge": [
    "Spatial alignment of multimodal remote sensing data",
    "Sensor fusion (Sentinel-1 SAR and Sentinel-2 multispectral optical)",
    "Relative position encoding for spatial extrapolation"
  ],
  "backbone_modifications": [
    "No sinusoidal position embeddings; uses 2D-ALiBi and X-ALiBi for spatial bias in attention"
  ],
  "supported_sensors": [
    "Sentinel-1",
    "Sentinel-2"
  ],
  "modality_integration_type": "Homogeneous Multimodal",
  "modalities": [
    "Multispectral",
    "SAR"
  ],
  "spectral_alignment": "partial",
  "temporal_alignment": "none",
  "spatial_resolution": "10m",
  "temporal_resolution": "variable",
