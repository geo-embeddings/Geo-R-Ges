  "version": "1.0",
  "release_date": "2025-08-04T00:00:00Z",
  "updated": "2025-08-04T00:00:00Z",
  "description": "SkySense++ is a multi-modal remote sensing foundation model with a factorized architecture, progressive two-stage pretraining (representation-enhanced and semantic-enhanced), and in-context learning capabilities for diverse Earth observation tasks. It supports multi-modal, multi-temporal data from 11 satellite platforms and demonstrates state-of-the-art performance across 12 EO tasks in 7 domains.",
  "sci:doi": "10.1038/s42256-025-01078-8",
