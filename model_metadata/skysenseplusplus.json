  "mlm:architecture": "Factorized multi-modal spatio-temporal encoder (Swin Transformer for HR, ViT for MS and SAR)",
  "mlm:total_parameters": 2000000000,
  "pretext_training_type": "Self-supervised (multi-granularity contrastive learning) and masked semantic learning",
  "masking_strategy": "Random masking of category labels (semantic masking) and random modality dropout (masked modality completion)",
  "pretraining": "Progressive two-stage pretraining: (1) representation-enhanced pretraining with multi-granularity contrastive learning on unlabelled data; (2) semantic-enhanced pretraining with masked semantic learning on labelled data",
  "domain_knowledge": [
    "Semantic banks for category encoding",
    "Spatio-temporal-modality decoupling",
    "Masked modality completion"
  ],
  "backbone_modifications": [
    "Factorized multi-modal spatio-temporal encoder",
    "Masked modality completion module",
    "Semantic bank integration"
  ],
