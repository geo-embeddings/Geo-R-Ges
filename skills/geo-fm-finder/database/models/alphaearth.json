  "mlm:pretrained_source": "Multi-source: Sentinel-2 L1C, Landsat-8/9 L1C, Sentinel-1 GRD, ALOS PALSAR-2, GEDI L2A, Copernicus DEM GLO-30, ERA5-Land, GRACE, NLCD, Wikipedia, GBIF",
  "regions_coverage": [
    "Global terrestrial land surface",
    "Near-shore ecosystems",
    "Coral reefs",
    "Intertidal zones"
  ],
  "start_datetime": "2017-01-01T00:00:00Z",
  "end_datetime": "2023-12-31T23:59:59Z",
  "num_images": 3047520515,
  "sampling": "Stratified by ecoregion, gridded text, coral, intertidal; 1.28km minimum spacing; two non-overlapping periods per site",
  "processing:level": "Sentinel-2 L1C, Landsat-8/9 L1C, Sentinel-1 GRD, ALOS PALSAR-2 Level 2.2",
  "processing:lineage": "Reprojection to UTM; Bilinear resampling to 10m; Zero mean/unit variance scaling; Log-transform for optical bands; Cloud/quality masking for training",
  "cloud_cover": "Cloud Score+ (Sentinel-2), FMASK (Landsat); masks used for training only",
  "missing_data": "Masked pixels excluded from loss; missing frames replaced with masks; Antarctica excluded due to insufficient Sentinel-1",
  "mlm:hyperparameters": {
    "patch_size": "64 bytes per embedding (S63 unit sphere)",
