{
  "id": "alphaearth",
  "mlm:name": "AlphaEarth Foundations",
  "version": "v1",
  "release_date": "2025-09-10T00:00:00Z",
  "updated": "2026-10-28T00:00:00Z",
  "description": "AlphaEarth Foundations (AEF) is an embedding field model for geospatial representation learning, enabling accurate and efficient global mapping from sparse label data. It produces annual, global, analysis-ready embedding field layers at 10m spatial resolution, supporting multi-source, multi-modal, and time-continuous inputs.",
  "sci:doi": "10.48550/arXiv.2507.22291",
  "license": null,
  "assets": null,
  "mlm:architecture": "Space Time Precision (STP) encoder",
  "mlm:total_parameters": 480000000,
  "pretext_training_type": "Self-supervised contrastive learning with reconstruction, batch uniformity, consistency, and text contrastive objectives",
  "masking_strategy": "Random dropping of input sources and time-steps during training; no input masking at inference",
  "pretraining": "AEF is trained on over 3 billion observations from 2017-2023, across 8,412,511 video sequences from 5,145,244 unique sites, using multi-source raster and text data. Training uses a teacher-student model with contrastive and reconstruction losses, batch uniformity, and text alignment.",
  "domain_knowledge": [
    "Spatial pyramid exchanges",
    "Sinusoidal timecodes",
    "Von Mises-Fisher bottleneck",
    "Sensor geometry metadata",
    "Ecoregion stratified sampling"
  ],
  "backbone_modifications": [
    "Simultaneous space, time, and precision operators",
    "Spatial pyramid exchanges",
    "Learned Laplacian pyramid rescaling",
    "Time-axial self-attention",
    "Sinusoidal timecode conditioning"
  ],
  "supported_sensors": [
    "Sentinel-2",
    "Landsat-8",
    "Landsat-9",
    "Sentinel-1",
    "ALOS PALSAR-2",
    "GEDI",
    "Copernicus DEM GLO-30",
    "ERA5-Land",
    "GRACE"
  ],
  "modality_integration_type": "Heterogeneous Multimodal",
  "modalities": [
    "Multispectral",
    "SAR",
    "LiDAR",
    "Climate",
    "DEM",
    "Text"
  ],
  "spectral_alignment": "partial",
  "temporal_alignment": "full",
  "spatial_resolution": "10m",
  "temporal_resolution": "annual (embedding fields), supports continuous time",
