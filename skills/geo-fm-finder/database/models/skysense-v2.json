{
  "id": "skysense-v2",
  "mlm:name": "SkySense V2",
  "version": "2",
  "release_date": "2025-07-18T00:00:00Z",
  "updated": "2025-07-18T00:00:00Z",
  "description": "SkySense V2 is a unified multi-modal remote sensing foundation model (MM-RSFM) that employs a single transformer backbone for multiple modalities (HR optical, multispectral, SAR). It introduces adaptive patch merging, modality prompt tokens, and a mixture of experts module, and is pre-trained with a novel query-based semantic aggregation contrastive learning (QSACL) strategy. It achieves state-of-the-art results across 16 datasets and 7 tasks.",
  "sci:doi": "10.48550/arXiv.2507.13812",
  "license": null,
  "assets": null,
  "mlm:architecture": "Unified Transformer (SwinV2B + vanilla Transformer Blocks)",
  "mlm:total_parameters": 665000000,
  "pretext_training_type": "Self-supervised learning (SSL) with Multi-Granularity Contrastive Learning (MGCL), Query-based Semantic Aggregation Contrastive Learning (QSACL), Dense Image-Text Alignment (ITA), and Geo-Context Prototype Learning (GCPL)",
  "masking_strategy": "Adaptive Patch Merging (APM) for spatial harmonization; no explicit masking ratio for MIM",
  "pretraining": "Pre-trained on 21 million multi-modal remote sensing imagery sets (HR optical, Sentinel-2 MS, Sentinel-1 SAR) using a teacher-student architecture with multi-granularity contrastive learning, geo-context prototype learning, dense image-text alignment, and query-based semantic aggregation contrastive learning (QSACL).",
  "domain_knowledge": [
    "Geo-context prototype learning",
    "Dense image-text alignment with OSM labels"
  ],
  "backbone_modifications": [
    "Adaptive Patch Merging (APM)",
    "Learnable modality prompt tokens",
    "Mixture of Experts (MoE) in last 6 transformer blocks"
  ],
