{
  "id": "ringmo-aerial",
  "mlm:name": "RingMo-Aerial",
  "version": "v1",
  "release_date": null,
  "updated": null,
  "description": "RingMo-Aerial is the first large foundation model specifically tailored for Aerial Remote Sensing (ARS) vision tasks. It introduces Frequency-Enhanced Multi-Head Self-Attention (FE-MSA), an affine transformation-based contrastive learning pre-training method, and the ARS-Adapter for efficient fine-tuning. The model achieves state-of-the-art performance across multiple ARS and ApRS datasets and tasks, including semantic segmentation, object detection, scene classification, change detection, 3D reconstruction, and object tracking.",
  "sci:doi": "10.48550/arXiv.2409.13366",
  "license": null,
  "assets": null,
  "mlm:architecture": "Swin Transformer (Base)",
  "mlm:total_parameters": null,
  "pretext_training_type": "Masked Image Modeling (MIM) + Contrastive Learning (CL) with affine transformations",
  "masking_strategy": "Random masking (SimMIM) for MIM; affine transformation-based positive/negative pairs for CL",
  "pretraining": "Two-stage pretraining: Stage 1 uses Masked Image Modeling (SimMIM) to capture pixel-level semantic associations; Stage 2 uses contrastive learning with affine transformations to learn ARS-specific visual features.",
  "domain_knowledge": [
    "Frequency-Enhanced Multi-Head Self-Attention (FE-MSA)",
    "Affine Transformation Contrastive Learning (CLAF)",
    "ARS-Adapter for efficient fine-tuning"
  ],
