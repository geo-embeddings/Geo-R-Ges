      "type": "text/html",
      "roles": [
        "mlm:source_code",
        "code"
      ]
    }
  },
  "mlm:architecture": "ViT-Base",
  "mlm:total_parameters": 86000000,
  "pretext_training_type": "Masked image modeling (MIM) with auxiliary continual distillation",
  "masking_strategy": "Random patch masking (MAE-style), masking ratio 0.7",
  "pretraining": "Pretrained on Copernicus-Pretrain (220K grids with all modalities, 100 epochs) using masked image modeling and continual distillation from DINOv2 (RGB) and SoftCon (S1/S2). Dynamic hypernetworks generate patch embedding weights for spectral and non-spectral modalities. Metadata (location, area, time) is integrated via Fourier encoding.",
  "domain_knowledge": [
    "Fourier encoding for spectral/metadata",
    "Gaussian sampling for spatial diversity",
    "Metadata integration (location, area, time)",
    "Language model encoding for variable names"
  ],
  "backbone_modifications": [
    "Dynamic patch embedding via spectral and variable hypernetworks",
    "Flexible patch size (FlexiViT-inspired)",
    "Metadata integration via Fourier encoding"
  ],
  "supported_sensors": [
    "Sentinel-1",
    "Sentinel-2",
    "Sentinel-3",
    "Sentinel-5P",
    "Copernicus DEM"
  ],
  "modality_integration_type": "Heterogeneous Multimodal",
