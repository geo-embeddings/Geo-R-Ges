  "end_datetime": null,
  "num_images": 15720353,
  "sampling": "Gaussian sampling around top-10K populated cities (std=50km), uniform for polar regions, fill gaps for missing grids; Time range: Primarily 2021 (Sentinel-1/2/3/5P), DEM static",
  "processing:level": "S1: GRD, S2: TOA, S3: OLCI, S5P: L2, DEM: GLO-30",
  "processing:lineage": "Channel-wise normalization (S1/2); Scale factor multiplication (S3); NaN replacement (S5P); DEM normalization",
  "cloud_cover": "S3: filter tiles with >20% bright pixels; S5P: filter fully NaN tiles; S1/2: not specified",
  "missing_data": "Remove corrupted/NaN-dominated images; S5P NaNs replaced with zero",
