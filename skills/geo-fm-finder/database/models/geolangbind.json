{
  "id": "geolangbind",
  "mlm:name": "GeoLangBind",
  "version": "v1",
  "release_date": "2025-03-08T00:00:00Z",
  "updated": "2025-03-08T00:00:00Z",
  "description": "GeoLangBind is an agglomerative vision?language foundation model for Earth Observation (EO) that unifies heterogeneous EO data modalities (RGB, SAR, multispectral, hyperspectral, infrared, elevation, aerial) into a shared language embedding space. It leverages a large-scale multimodal image?text dataset (GeoLangBind-2M, 2M pairs, 6 modalities), a wavelength-aware dynamic encoder, a modality-aware knowledge agglomeration (MaKA) module, and progressive multimodal weight merging. GeoLangBind achieves state-of-the-art zero-shot and fine-tuned performance on classification, segmentation, and cross-modal retrieval across 23 EO datasets.",
  "sci:doi": "10.48550/arXiv.2503.06312",
  "license": null,
  "assets": null,
  "mlm:architecture": "ViT-Base (patch size 16) for base, SoViT-400m (patch size 14) for large",
  "mlm:total_parameters": null,
  "pretext_training_type": "Contrastive vision?language pretraining with multi-teacher knowledge distillation",
  "masking_strategy": "Progressive multimodal weight merging; dynamic patch embedding with wavelength-aware masking",
  "pretraining": "Initialized with SigLIP weights, trained on GeoLangBind-2M using pairwise sigmoid loss and multi-teacher feature-matching distillation (SigLIP, DINOv2, ViT)",
  "domain_knowledge": [
    "Wavelength-aware dynamic encoder",
    "Modality-aware knowledge agglomeration (MaKA)",
    "Progressive multimodal weight merging"
  ],
