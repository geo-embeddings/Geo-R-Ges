{
  "id": "mmearth",
  "mlm:name": "MP-MAE",
  "version": "v1",
  "release_date": "2024-07-29T00:00:00Z",
  "updated": "2024-07-29T00:00:00Z",
  "description": "MP-MAE is a Multi-Pretext Masked Autoencoder for geospatial representation learning, pretrained on the global, multi-modal MMEarth dataset (1.2M locations, 12 modalities). It extends ConvNeXt V2 MAE with multi-modal pretext tasks for learning general-purpose representations for Sentinel-2 optical images.",
  "sci:doi": "10.48550/arXiv.2405.02771",
  "license": null,
  "assets": {
    "mlm:source_code": {
      "href": "https://github.com/vishalned/MMEarth-train",
      "title": "Source code",
      "type": "text/html",
      "roles": [
        "mlm:source_code",
        "code"
      ]
    }
  },
  "mlm:architecture": "ConvNeXt V2-Atto",
  "mlm:total_parameters": 3700000,
  "pretext_training_type": "Multi-modal masked autoencoding with multi-pretext tasks (pixel-level and image-level modalities)",
  "masking_strategy": "Random masking of input patches (16x16 or 8x8) with learnable mask token; same mask applied to all pixel-level modalities",
  "pretraining": "Masked autoencoding with multi-modal reconstruction tasks (pixel-level and image-level) using MMEarth dataset. Task-uncertainty weighted multi-task loss.",
  "domain_knowledge": [
    "Biome-balanced sampling",
    "Stratified sampling across ecoregions",
    "Cyclic encoding of geolocation and date",
    "Harmonization of Sentinel-2 L1C/L2A products"
  ],
  "backbone_modifications": [
    "Reduced patch size (from 32 to 16 or 8) for medium-resolution satellite images",
    "Modified first layer to avoid early downsampling (kernel size 3, stride 1)",
    "Initial convolutional layer at input resolution followed by depth-wise downsampling"
  ],
  "supported_sensors": [
    "Sentinel-2",
    "Sentinel-1",
    "ASTER",
    "GEDI (via ETH-GCHM)",
    "ERA5"
  ],
  "modality_integration_type": "Homogeneous Multimodal",
  "modalities": [
    "Multispectral",
    "SAR",
    "DEM",
    "Vegetation Height",
    "Landcover (categorical)",
    "Climate (temperature, precipitation)",
    "Geolocation",
    "Date"
  ],
  "spectral_alignment": "partial",
  "temporal_alignment": "partial",
  "spatial_resolution": "10m",
  "temporal_resolution": "5 days (Sentinel-2); 2017-2020",
  "mlm:input": [
    {
      "name": "Sentinel-2, Sentinel-1, ASTER, GEDI (via ETH-GCHM), ERA5",
      "bands": [
        "Sentinel-2 B1-B12 (L1C/L2A)",
        "Sentinel-1 VV, VH, HV, HH",
        "ASTER elevation, slope",
        "ETH-GCHM canopy height, uncertainty",
        "Dynamic World landcover",
        "ESA World Cover landcover"
      ]
    }
  ],
  "mlm:pretrained_source": "MMEarth",
  "regions_coverage": [
    "Global",
    "14 biomes",
    "846 ecoregions"
  ],
  "start_datetime": "2017-01-01T00:00:00Z",
  "end_datetime": "2020-12-31T23:59:59Z",
  "num_images": 1200000,
  "sampling": "Biome-balanced, stratified by ecoregion, uniform across 14 biomes and 4 years",
  "processing:level": "Sentinel-2 L1C and L2A",
  "processing:lineage": "Standardization (zero mean, unit variance) per channel; Harmonization of L1C/L2A; Bilinear interpolation to 10m grid; Center cropping; Missing input pixels replaced by zero; Local patch normalization for optical bands",
  "cloud_cover": "CLOUD_PIXEL_PERCENTAGE < 10% at tile level",
  "missing_data": "Missing input pixels replaced by zero; Dynamic World NO_DATA handled as class 0; no sample-level cloud filtering",
